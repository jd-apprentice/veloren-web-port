+//! Serial stand-ins for the rayon `ParallelIterator` combinators used by systems.
+//!
+//! On `wasm32` the `specs` `parallel` feature is disabled (there is no rayon
+//! thread pool), so joins are serial. This shim lets the existing
+//! `<tuple>.par_join()` call sites keep working unchanged by returning a wrapper
+//! that offers the same combinators (`filter`, `map`, `map_init`,
+//! `for_each_init`, `fold`, `reduce`) backed by a plain iterator. It is only
+//! compiled for wasm; native keeps using rayon through `specs`'s `ParJoin`.
+
+use specs::{Join, join::JoinIter};
+use std::iter::{Filter, Map, Once};
+
+/// A wrapper around a serial join iterator exposing rayon-style combinators.
+pub struct SerialJoin<I>(I);
+
+impl<I: Iterator> SerialJoin<I> {
+    pub fn filter<P>(self, predicate: P) -> SerialJoin<Filter<I, P>>
+    where
+        P: FnMut(&I::Item) -> bool,
+    {
+        SerialJoin(self.0.filter(predicate))
+    }
+
+    pub fn map_init<B, H, G, F>(
+        self,
+        mut init: G,
+        mut f: F,
+    ) -> SerialJoin<Map<I, impl FnMut(I::Item) -> B>>
+    where
+        G: FnMut() -> H,
+        F: FnMut(&mut H, I::Item) -> B,
+    {
+        // Single-threaded, so a single "thread local" state is shared by every
+        // item instead of one per rayon worker.
+        let mut h = init();
+        SerialJoin(self.0.map(move |item| f(&mut h, item)))
+    }
+
+    pub fn for_each_init<H, G, F>(self, mut init: G, mut f: F)
+    where
+        G: FnMut() -> H,
+        F: FnMut(&mut H, I::Item),
+    {
+        let mut h = init();
+        self.0.for_each(|item| f(&mut h, item));
+    }
+
+    /// Emulates rayon's `fold`, which yields one accumulator per partition. In a
+    /// serial run there is exactly one partition, so this yields a single value
+    /// that a following `reduce` combines.
+    pub fn fold<T, ID, F>(self, mut init: ID, mut f: F) -> SerialJoin<Once<T>>
+    where
+        ID: FnMut() -> T,
+        F: FnMut(T, I::Item) -> T,
+    {
+        SerialJoin(std::iter::once(
+            self.0.fold(init(), |acc, item| f(acc, item)),
+        ))
+    }
+
+    pub fn reduce<T, ID, F>(self, mut init: ID, mut f: F) -> T
+    where
+        I: Iterator<Item = T>,
+        ID: FnMut() -> T,
+        F: FnMut(T, T) -> T,
+    {
+        self.0.fold(init(), |acc, item| f(acc, item))
+    }
+}
+
+/// Serial stand-in for `specs::ParJoin`, providing `.par_join()` on wasm.
+pub trait ParJoinSerial: Join + Sized {
+    fn par_join(self) -> SerialJoin<JoinIter<Self>> { SerialJoin(self.join()) }
+}
+
+impl<T: Join + Sized> ParJoinSerial for T {}

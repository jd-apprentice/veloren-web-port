diff --git a/network/src/rt.rs b/network/src/rt.rs
new file mode 100644
index 0000000..82838ad
--- /dev/null
+++ b/network/src/rt.rs
@@ -0,0 +1,56 @@
+use std::future::Future;
+use std::time::Duration;
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) struct Task(tokio::task::JoinHandle<()>);
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) struct Task;
+
+impl Task {
+    pub(crate) fn abort(&self) {
+        #[cfg(not(target_arch = "wasm32"))]
+        self.0.abort();
+    }
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn spawn<F>(fut: F) -> Task
+where
+    F: Future<Output = ()> + Send + 'static,
+{
+    Task(tokio::spawn(fut))
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) fn spawn<F>(fut: F) -> Task
+where
+    F: Future<Output = ()> + 'static,
+{
+    wasm_bindgen_futures::spawn_local(fut);
+    Task
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) async fn sleep(d: Duration) {
+    tokio::time::sleep(d).await;
+}
+
+#[cfg(target_arch = "wasm32")]
+pub(crate) async fn sleep(d: Duration) {
+    gloo_timers::future::TimeoutFuture::new(d.as_millis() as u32).await;
+}
+
+pub(crate) struct Interval {
+    period: Duration,
+}
+
+impl Interval {
+    pub(crate) fn new(period: Duration) -> Self {
+        Self { period }
+    }
+
+    pub(crate) async fn tick(&mut self) {
+        sleep(self.period).await;
+    }
+}

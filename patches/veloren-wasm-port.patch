diff --git a/voxygen/src/web.rs b/voxygen/src/web.rs
new file mode 100644
index 0000000..b92ee3d
--- /dev/null
+++ b/voxygen/src/web.rs
@@ -0,0 +1,96 @@
+//! Web (wasm) entry point for the browser build.
+//!
+//! Mirrors `main.rs` but: no CLI, no tokio multi-thread runtime, no audio, no
+//! filesystem — assets are preloaded over HTTP and the window/renderer are
+//! created asynchronously.
+#![cfg(target_arch = "wasm32")]
+
+use crate::{
+    GlobalState,
+    audio::AudioFrontend,
+    profile::Profile,
+    run,
+    scene::terrain::SpriteRenderContext,
+    settings::{Settings, get_fps},
+    window::Window,
+};
+use common::clock::Clock;
+use i18n::LocalizationHandle;
+use std::sync::Arc;
+use wasm_bindgen_futures::spawn_local;
+
+const ASSETS_BASE: &str = "/spikes/vendor/veloren/assets";
+const MANIFEST_URL: &str = "/spikes/voxharness/assets-manifest.txt";
+
+pub fn start() {
+    console_error_panic_hook::set_once();
+    spawn_local(async move {
+        if let Err(e) = run_web().await {
+            web_sys::console::error_1(&format!("voxygen web error: {e}").into());
+        }
+    });
+}
+
+async fn run_web() -> Result<(), String> {
+    let mut settings = Settings::default();
+    client::set_auth_proxy("http://127.0.0.1:9100/auth".to_string());
+    settings.graphics.render_mode.rain_enabled = false;
+    settings.graphics.render_mode.bloom = crate::render::BloomMode::Off;
+    settings.graphics.render_mode.shadow = crate::render::ShadowMode::None;
+    log("web: start");
+
+    let manifest = common::assets::load_manifest(MANIFEST_URL).await?;
+    log(&format!("web: manifest {} files", manifest.len()));
+    let paths: Vec<&str> = manifest.iter().map(String::as_str).collect();
+    common::assets::preload(ASSETS_BASE, &paths, |_, _| {}).await?;
+    log(&format!("web: preloaded {}", paths.len()));
+
+    let audio = AudioFrontend::no_audio();
+    let profile = Profile::default();
+
+    let mut i18n = LocalizationHandle::load_expect(&settings.language.selected_language);
+    i18n.set_english_fallback(settings.language.use_english_fallback);
+    log("web: i18n loaded");
+
+    let (mut window, event_loop) = Window::new(&settings)
+        .await
+        .map_err(|e| format!("{e:?}"))?;
+    log("web: window created");
+
+    let clipboard = crate::ui::ice::Clipboard::connect(window.window());
+    let lazy_init = SpriteRenderContext::new(window.renderer_mut());
+
+    let tokio_runtime = Arc::new(
+        tokio::runtime::Builder::new_current_thread()
+            .build()
+            .map_err(|e| format!("{e:?}"))?,
+    );
+
+    use clap::Parser;
+    let args = crate::cli::Args::parse_from(std::iter::empty::<std::ffi::OsString>());
+
+    let global_state = GlobalState {
+        userdata_dir: std::path::PathBuf::new(),
+        config_dir: std::path::PathBuf::new(),
+        audio,
+        profile,
+        window,
+        tokio_runtime,
+        lazy_init,
+        clock: Clock::new(std::time::Duration::from_secs_f64(
+            1.0 / get_fps(settings.graphics.max_fps) as f64,
+        )),
+        settings,
+        info_message: None,
+        i18n,
+        clipboard,
+        clear_shadows_next_frame: false,
+        args,
+    };
+
+    log("web: entering event loop");
+    run::run(global_state, event_loop).map_err(|e| format!("{e:?}"))?;
+    Ok(())
+}
+
+fn log(msg: &str) { web_sys::console::log_1(&msg.into()); }

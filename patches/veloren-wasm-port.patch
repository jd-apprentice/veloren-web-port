+///////////////////////////////////////
+// WebSocket (wasm)
+#[cfg(target_arch = "wasm32")]
+#[derive(Debug)]
+pub struct WsDrain {
+    tx: futures_channel::mpsc::UnboundedSender<BytesMut>,
+}
+
+#[cfg(target_arch = "wasm32")]
+#[derive(Debug)]
+pub struct WsSink {
+    rx: futures_channel::mpsc::UnboundedReceiver<BytesMut>,
+}
+
+#[cfg(target_arch = "wasm32")]
+#[derive(Debug)]
+pub struct WsError(pub String);
+
+#[cfg(target_arch = "wasm32")]
+#[async_trait]
+impl UnreliableDrain for WsDrain {
+    type CustomErr = ProtocolsError;
+    type DataFormat = BytesMut;
+
+    async fn send(&mut self, data: Self::DataFormat) -> Result<(), ProtocolError<Self::CustomErr>> {
+        self.tx.unbounded_send(data).map_err(|_| {
+            ProtocolError::Custom(ProtocolsError::Ws(WsError("drain closed".into())))
+        })
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+#[async_trait]
+impl UnreliableSink for WsSink {
+    type CustomErr = ProtocolsError;
+    type DataFormat = BytesMut;
+
+    async fn recv(&mut self) -> Result<Self::DataFormat, ProtocolError<Self::CustomErr>> {
+        use futures_util::StreamExt;
+        self.rx
+            .next()
+            .await
+            .ok_or(ProtocolError::Custom(ProtocolsError::Ws(WsError("sink closed".into()))))
+    }
+}
+
+#[cfg(target_arch = "wasm32")]
+mod ws {
+    use super::*;
+    use futures_channel::oneshot;
+    use futures_util::future::{self, Either};
+    use futures_util::StreamExt;
+    use wasm_bindgen::prelude::*;
+    use wasm_bindgen::JsCast;
+    use wasm_bindgen_futures::spawn_local;
+
+    pub(super) async fn connect(url: &str) -> Result<(WsDrain, WsSink), JsValue> {
+        let ws = web_sys::WebSocket::new(url)?;
+        ws.set_binary_type(web_sys::BinaryType::Arraybuffer);
+
+        let (open_tx, open_rx) = oneshot::channel::<()>();
+        let onopen = Closure::once_into_js(move || {
+            let _ = open_tx.send(());
+        });
+        ws.set_onopen(Some(onopen.unchecked_ref()));
+        let (err_tx, err_rx) = oneshot::channel::<String>();
+        let onerror = Closure::once_into_js(move || {
+            let _ = err_tx.send("websocket error before open".into());
+        });
+        ws.set_onerror(Some(onerror.unchecked_ref()));
+
+        futures_util::pin_mut!(open_rx, err_rx);
+        match future::select(open_rx, err_rx).await {
+            Either::Left(_) => {},
+            Either::Right((e, _)) => return Err(JsValue::from_str(&e.unwrap_or_default())),
+        }
+
+        let (out_tx, mut out_rx) = futures_channel::mpsc::unbounded::<BytesMut>();
+        let (in_tx, in_rx) = futures_channel::mpsc::unbounded::<BytesMut>();
+
+        let onmessage =
+            Closure::<dyn FnMut(web_sys::MessageEvent)>::new(move |e: web_sys::MessageEvent| {
+                if let Ok(buf) = e.data().dyn_into::<js_sys::ArrayBuffer>() {
+                    let arr = js_sys::Uint8Array::new(&buf);
+                    let _ = in_tx.unbounded_send(BytesMut::from(&arr.to_vec()[..]));
+                }
+            });
+        ws.set_onmessage(Some(onmessage.as_ref().unchecked_ref()));
+        onmessage.forget();
+
+        let ws_out = ws.clone();
+        spawn_local(async move {
+            while let Some(data) = out_rx.next().await {
+                let arr = js_sys::Uint8Array::from(&data[..]);
+                let _ = ws_out.send_with_array_buffer(&arr.buffer());
+            }
+        });
+
+        Ok((WsDrain { tx: out_tx }, WsSink { rx: in_rx }))
+    }
+}

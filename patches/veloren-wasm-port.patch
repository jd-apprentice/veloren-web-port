diff --git a/client/src/auth_wasm.rs b/client/src/auth_wasm.rs
new file mode 100644
index 0000000..7f268b0
--- /dev/null
+++ b/client/src/auth_wasm.rs
@@ -0,0 +1,61 @@
+use crate::error::Error;
+use argon2::{Algorithm, Argon2, Params, Version};
+use serde::Deserialize;
+
+#[derive(Deserialize)]
+struct SignInResponse {
+    token: Token,
+}
+
+#[derive(Deserialize)]
+struct Token {
+    unique: u64,
+}
+
+fn net_prehash(password: &str) -> String {
+    let salt = fxhash::hash64(password);
+    let params = Params::new(4096, 3, 1, Some(32)).expect("valid argon2 params");
+    let argon = Argon2::new(Algorithm::Argon2i, Version::V0x13, params);
+    let mut out = [0u8; 32];
+    argon
+        .hash_password_into(password.as_bytes(), &salt.to_le_bytes(), &mut out)
+        .expect("argon2 hashing must not fail");
+    hex::encode(out)
+}
+
+thread_local! {
+    static PROXY: std::cell::RefCell<Option<String>> = const { std::cell::RefCell::new(None) };
+}
+
+pub fn set_proxy(base: String) {
+    PROXY.with(|p| *p.borrow_mut() = Some(base));
+}
+
+pub async fn sign_in(username: &str, password: &str) -> Result<String, Error> {
+    let base = PROXY
+        .with(|p| p.borrow().clone())
+        .ok_or_else(|| Error::Other("auth proxy not set".into()))?;
+    let url = format!("{base}/generate_token");
+    let body = serde_json::json!({
+        "username": username,
+        "password": net_prehash(password),
+    });
+    let resp = gloo_net::http::Request::post(&url)
+        .header("content-type", "application/json")
+        .json(&body)
+        .map_err(|e| Error::Other(format!("auth request build: {e}")))?
+        .send()
+        .await
+        .map_err(|e| Error::Other(format!("auth request: {e}")))?;
+    let status = resp.status();
+    let text = resp
+        .text()
+        .await
+        .map_err(|e| Error::Other(format!("auth response: {e}")))?;
+    if !(200..300).contains(&status) {
+        return Err(Error::AuthErr(format!("auth server {status}: {text}")));
+    }
+    let parsed: SignInResponse =
+        serde_json::from_str(&text).map_err(|e| Error::AuthErr(format!("auth json: {e}")))?;
+    Ok(parsed.token.unique.to_string())
+}

diff --git a/common/assets/src/web.rs b/common/assets/src/web.rs
new file mode 100644
index 0000000..0b9ff62
--- /dev/null
+++ b/common/assets/src/web.rs
@@ -0,0 +1,188 @@
+//! A wasm `assets_manager::Source` backed by assets fetched over HTTP.
+//!
+//! `assets_manager`'s `Source` trait is synchronous, so assets are preloaded
+//! once (async `fetch`, cached in Cache Storage) into memory and then served
+//! from there. Files are keyed exactly like `assets_manager`'s `Embedded`
+//! source: `(id, ext)`, where `id` uses `.` as the path separator and `ext` may
+//! itself contain dots.
+
+use assets_manager::source::{DirEntry, FileContent, OwnedDirEntry, Source};
+use std::{collections::HashMap, io, path::Path, sync::OnceLock};
+use wasm_bindgen::JsCast;
+use wasm_bindgen_futures::JsFuture;
+
+const CACHE_NAME: &str = "veloren-assets";
+
+struct WebData {
+    files: HashMap<(String, String), Vec<u8>>,
+    dirs: HashMap<String, Vec<OwnedDirEntry>>,
+}
+
+static DATA: OnceLock<WebData> = OnceLock::new();
+
+/// In-memory source populated by [`preload`].
+#[derive(Debug, Clone, Copy)]
+pub struct WebSource;
+
+impl Source for WebSource {
+    fn read(&self, id: &str, ext: &str) -> io::Result<FileContent<'_>> {
+        let data = DATA
+            .get()
+            .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "assets not preloaded"))?;
+        match data.files.get(&(id.to_owned(), ext.to_owned())) {
+            Some(bytes) => Ok(FileContent::Slice(bytes)),
+            None => Err(io::ErrorKind::NotFound.into()),
+        }
+    }
+
+    fn read_dir(&self, id: &str, f: &mut dyn FnMut(DirEntry)) -> io::Result<()> {
+        let data = DATA
+            .get()
+            .ok_or_else(|| io::Error::new(io::ErrorKind::NotFound, "assets not preloaded"))?;
+        let entries = data.dirs.get(id).ok_or(io::ErrorKind::NotFound)?;
+        entries.iter().for_each(|e| f(e.as_dir_entry()));
+        Ok(())
+    }
+
+    fn exists(&self, entry: DirEntry) -> bool {
+        match DATA.get() {
+            Some(data) => match entry {
+                DirEntry::File(id, ext) => data.files.contains_key(&(id.to_owned(), ext.to_owned())),
+                DirEntry::Directory(id) => data.dirs.contains_key(id),
+            },
+            None => false,
+        }
+    }
+}
+
+/// Fetch `manifest_url` and return its non-empty, non-comment lines as relative
+/// asset paths.
+pub async fn load_manifest(manifest_url: &str) -> Result<Vec<String>, String> {
+    let bytes = fetch_cached(manifest_url).await?;
+    let text = String::from_utf8(bytes).map_err(|e| format!("manifest not utf8: {e}"))?;
+    Ok(text
+        .lines()
+        .map(str::trim)
+        .filter(|l| !l.is_empty() && !l.starts_with('#'))
+        .map(str::to_owned)
+        .collect())
+}
+
+/// Fetch every path in `manifest` (relative to `base_url`) into memory and
+/// install it as the global asset source. Must be called before any asset load.
+/// `on_progress` is called as `(loaded, total)` after each file.
+pub async fn preload(
+    base_url: &str,
+    manifest: &[&str],
+    mut on_progress: impl FnMut(usize, usize),
+) -> Result<usize, String> {
+    let total = manifest.len();
+    let mut files: HashMap<(String, String), Vec<u8>> = HashMap::new();
+    for (i, path) in manifest.iter().enumerate() {
+        let url = format!("{}/{}", base_url.trim_end_matches('/'), path);
+        let bytes = fetch_cached(&url)
+            .await
+            .map_err(|e| format!("fetch {path}: {e}"))?;
+        files.insert(id_ext_of(path), bytes);
+        on_progress(i + 1, total);
+    }
+    let dirs = build_dirs(&files);
+    let count = files.len();
+    DATA.set(WebData { files, dirs })
+        .map_err(|_| "assets already preloaded".to_string())?;
+    Ok(count)
+}
+
+/// Fetch a URL, using Cache Storage as a best-effort cache (survives reloads).
+async fn fetch_cached(url: &str) -> Result<Vec<u8>, String> {
+    let cache = open_cache().await.ok();
+    if let Some(cache) = &cache {
+        if let Ok(existing) = JsFuture::from(cache.match_with_str(url)).await {
+            if !existing.is_undefined() && !existing.is_null() {
+                if let Ok(resp) = existing.dyn_into::<web_sys::Response>() {
+                    return read_bytes(resp).await;
+                }
+            }
+        }
+    }
+    let resp = fetch_response(url).await?;
+    if let Some(cache) = &cache {
+        if let Ok(clone) = resp.clone() {
+            let _ = JsFuture::from(cache.put_with_str(url, &clone)).await;
+        }
+    }
+    read_bytes(resp).await
+}
+
+async fn fetch_response(url: &str) -> Result<web_sys::Response, String> {
+    let win = web_sys::window().ok_or("no window")?;
+    let value = JsFuture::from(win.fetch_with_str(url))
+        .await
+        .map_err(|e| format!("{e:?}"))?;
+    let resp: web_sys::Response = value.dyn_into().map_err(|_| "not a Response")?;
+    if !resp.ok() {
+        return Err(format!("HTTP {}", resp.status()));
+    }
+    Ok(resp)
+}
+
+async fn read_bytes(resp: web_sys::Response) -> Result<Vec<u8>, String> {
+    let buffer = JsFuture::from(resp.array_buffer().map_err(|e| format!("{e:?}"))?)
+        .await
+        .map_err(|e| format!("{e:?}"))?;
+    Ok(js_sys::Uint8Array::new(&buffer).to_vec())
+}
+
+async fn open_cache() -> Result<web_sys::Cache, String> {
+    let caches = web_sys::window()
+        .ok_or("no window")?
+        .caches()
+        .map_err(|e| format!("caches unavailable: {e:?}"))?;
+    let promise = caches.open(CACHE_NAME);
+    JsFuture::from(promise)
+        .await
+        .map_err(|e| format!("open cache: {e:?}"))?
+        .dyn_into::<web_sys::Cache>()
+        .map_err(|_| "not a Cache".to_string())
+}
+
+fn id_ext_of(rel: &str) -> (String, String) {
+    let path = Path::new(rel);
+    let name = path.file_name().and_then(|n| n.to_str()).unwrap_or(rel);
+    let (stem, ext) = name.split_once('.').unwrap_or((name, ""));
+    let dir = path.parent().and_then(|p| p.to_str()).unwrap_or("");
+    let id = if dir.is_empty() {
+        stem.to_owned()
+    } else {
+        format!("{}.{}", dir.replace('/', "."), stem)
+    };
+    (id, ext.to_owned())
+}
+
+fn parent_id(id: &str) -> String {
+    id.rfind('.').map_or(String::new(), |i| id[..i].to_owned())
+}
+
+fn build_dirs(files: &HashMap<(String, String), Vec<u8>>) -> HashMap<String, Vec<OwnedDirEntry>> {
+    let mut dirs: HashMap<String, Vec<OwnedDirEntry>> = HashMap::new();
+    dirs.entry(String::new()).or_default();
+    for (id, ext) in files.keys() {
+        let parent = parent_id(id);
+        dirs.entry(parent.clone())
+            .or_default()
+            .push(OwnedDirEntry::File(id.clone().into(), ext.clone().into()));
+        let mut cur = parent;
+        while !cur.is_empty() {
+            let p = parent_id(&cur);
+            let entry = dirs.entry(p.clone()).or_default();
+            let already = entry
+                .iter()
+                .any(|e| matches!(e, OwnedDirEntry::Directory(d) if d.as_ref() == cur));
+            if !already {
+                entry.push(OwnedDirEntry::Directory(cur.clone().into()));
+            }
+            cur = p;
+        }
+    }
+    dirs
+}

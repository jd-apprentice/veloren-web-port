+/// On wasm we run single-threaded, so slow jobs are simply executed inline when
+/// spawned. This keeps the same API surface without any rayon thread pool.
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Default)]
+pub struct SlowJobPool;
+
+#[cfg(target_arch = "wasm32")]
+impl SlowJobPool {
+    pub fn new(_global_limit: u64, _jobs_metrics_cnt: usize, _threadpool: ()) -> Self { Self }
+
+    /// configure a NAME to spawn up to f(n) threads, depending on how many
+    /// threads we globally have available
+    pub fn configure<F>(&self, _name: &str, _f: F)
+    where
+        F: Fn(u64) -> u64,
+    {
+    }
+
+    /// spawn a new slow job on a certain NAME IF it can run immediately
+    #[expect(clippy::result_unit_err)]
+    pub fn try_run<F>(&self, name: &str, f: F) -> Result<SlowJob, ()>
+    where
+        F: FnOnce() + Send + Sync + 'static,
+    {
+        f();
+        Ok(SlowJob {
+            name: name.to_owned(),
+            id: 0,
+        })
+    }
+
+    pub fn spawn<F>(&self, name: &str, f: F) -> SlowJob
+    where
+        F: FnOnce() + Send + Sync + 'static,
+    {
+        f();
+        SlowJob {
+            name: name.to_owned(),
+            id: 0,
+        }
+    }
+
+    pub fn cancel(&self, job: SlowJob) -> Result<(), SlowJob> { Err(job) }
+
+    pub fn take_metrics(&self) -> HashMap<String, Vec<JobMetrics>> { HashMap::new() }
+}
